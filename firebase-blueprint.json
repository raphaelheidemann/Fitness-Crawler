{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user program configuration, current active week, macro targets, and unit preferences.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name."
        },
        "currentWeek": {
          "type": "integer",
          "description": "Active training and diet plan week number (1-52)."
        },
        "phaseName": {
          "type": "string",
          "maxLength": 80,
          "description": "Current program phase label such as Lean Hypertrophy or Cut."
        },
        "unitSystem": {
          "type": "string",
          "enum": ["metric", "imperial"],
          "description": "Preferred measurement unit system."
        },
        "startDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Program start date in YYYY-MM-DD format."
        },
        "targetWeight": {
          "type": "number",
          "description": "Target body weight in user unit system."
        },
        "dailyCalorieTarget": {
          "type": "integer",
          "description": "Daily caloric intake target."
        },
        "proteinTargetG": {
          "type": "integer",
          "description": "Daily protein target in grams."
        },
        "carbsTargetG": {
          "type": "integer",
          "description": "Daily carbohydrate target in grams."
        },
        "fatTargetG": {
          "type": "integer",
          "description": "Daily fat target in grams."
        },
        "weeklyWorkoutTarget": {
          "type": "integer",
          "description": "Target gym sessions per week (1-7)."
        },
        "mealsPerDay": {
          "type": "integer",
          "description": "Configured number of daily meal slots (1-10)."
        },
        "dailyWaterGoalMl": {
          "type": "integer",
          "description": "Daily hydration target in milliliters (500-10000)."
        },
        "sex": {
          "type": "string",
          "enum": ["male", "female", "unspecified"],
          "description": "User biological sex used for BMR estimation."
        },
        "crawlerStyle": {
          "type": "string",
          "enum": ["masculine", "feminine", "neutral"],
          "description": "Preferred crawler avatar presentation style."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "currentWeek",
        "phaseName",
        "unitSystem",
        "startDate",
        "targetWeight",
        "dailyCalorieTarget",
        "proteinTargetG",
        "carbsTargetG",
        "fatTargetG",
        "weeklyWorkoutTarget",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkoutDay": {
      "title": "WorkoutDay",
      "description": "Scheduled gym session for a specific week and day index with exercises and completion status.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weekNumber": {
          "type": "integer",
          "description": "Week number (1-52)."
        },
        "dayIndex": {
          "type": "integer",
          "description": "Day of week index (0=Mon through 6=Sun)."
        },
        "focus": {
          "type": "string",
          "maxLength": 80,
          "description": "Training split focus for the day."
        },
        "planId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional linked reusable WorkoutPlan ID."
        },
        "planName": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional linked WorkoutPlan display name."
        },
        "isRestDay": {
          "type": "boolean",
          "description": "Whether the day is a scheduled rest or recovery day."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the workout session is completed."
        },
        "exercises": {
          "type": "array",
          "description": "List of up to 25 structured exercise objects."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Session notes or RPE summary."
        },
        "cardio": {
          "type": "object",
          "description": "Optional walk or run cardio log for the day.",
          "properties": {
            "activityType": {
              "type": "string",
              "enum": ["none", "walk", "run"]
            },
            "distance": {
              "type": "number"
            },
            "durationMinutes": {
              "type": "number"
            },
            "caloriesBurned": {
              "type": "number"
            },
            "paceOrIncline": {
              "type": "string",
              "maxLength": 60
            },
            "completed": {
              "type": "boolean"
            }
          }
        },
        "durationSec": {
          "type": "integer",
          "description": "Optional active workout session duration in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "weekNumber",
        "dayIndex",
        "focus",
        "isRestDay",
        "completed",
        "exercises",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
