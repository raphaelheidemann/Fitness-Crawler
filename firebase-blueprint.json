        },
        "xp": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "weeklyClears": {
          "type": "integer"
        },
        "currentStreak": {
          "type": "integer"
        },
        "bestStreak": {
          "type": "integer"
        },
